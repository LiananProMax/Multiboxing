<ui:FluentWindow x:Class="KeyMouseSyncReplica.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:KeyMouseSyncReplica"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="多窗口键鼠同步器"
                 Width="880"
                 Height="560"
                 MinWidth="780"
                 MinHeight="500"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource AppBackgroundBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="多窗口键鼠同步器" />

        <Border Grid.Row="1"
                Margin="14,8,14,8"
                Padding="14,10"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Windows 消息键鼠同步"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding MainWindowSummary}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Padding="10,4"
                            CornerRadius="999"
                            Background="#EAF2FF"
                            HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SyncStatusText}"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}">
                        <Run Text="窗口 " />
                        <Run Text="{Binding WindowCount, Mode=OneWay}" />
                        <Run Text=" · 目标 " />
                        <Run Text="{Binding TargetCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="14,0,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="同步窗口列表"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="选中行或右键单击进行操作" />
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Windows}"
                              SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              BorderThickness="0"
                              RowHeight="26"
                              FontSize="12"
                              AlternatingRowBackground="#F8FAFC">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="WindowsDataGridRow_PreviewMouseRightButtonDown" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="设为主窗口"
                                                      Command="{Binding PlacementTarget.Tag.SetMainWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="测试同步"
                                                      Command="{Binding PlacementTarget.Tag.TestMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="删除窗口"
                                                      Command="{Binding PlacementTarget.Tag.DeleteWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Tag"
                                        Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="句柄" Binding="{Binding HandleHex}" Width="90" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                            <DataGridTextColumn Header="标题" Binding="{Binding DisplayTitle}" Width="*" />
                            <DataGridTextColumn Header="消息" Binding="{Binding BindState}" Width="80" />
                            <DataGridTextColumn Header="同步" Binding="{Binding SyncState}" Width="90" />
                            <DataGridTextColumn Header="模式" Binding="{Binding CurrentMode}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:TargetPickerButton x:Name="TargetPicker"
                                                  Width="64"
                                                  Height="64"
                                                  MinWidth="64"
                                                  MinHeight="64"
                                                  PickCompleted="TargetPicker_PickCompleted" />
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="选择窗口"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="按住十字拖到目标窗口后松开" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="同步操作"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,8,4,0"
                                MinHeight="28"
                                Padding="6,2"
                                Content="添加窗口"
                                Command="{Binding AddWindowCommand}" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Margin="4,8,0,0"
                                MinHeight="28"
                                Padding="6,2"
                                Content="删除"
                                Command="{Binding DeleteWindowCommand}" />
                        <Button Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,6,0,0"
                                MinHeight="28"
                                Padding="6,2"
                                Content="设为主窗口"
                                Command="{Binding SetMainWindowCommand}" />
                        <Button Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,6,4,0"
                                MinHeight="32"
                                Padding="6,2"
                                FontWeight="SemiBold"
                                Content="{Binding ToggleSyncText}"
                                Command="{Binding ToggleSyncCommand}" />
                        <Button Grid.Row="3"
                                Grid.Column="1"
                                Margin="4,6,0,0"
                                MinHeight="32"
                                Padding="6,2"
                                Content="测试同步"
                                Command="{Binding TestMessageCommand}" />

                        <StackPanel Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="0,10,0,0">
                            <CheckBox Content="键盘同步"
                                      FontSize="12"
                                      IsChecked="{Binding SyncKeyboard, Mode=TwoWay}" />
                            <CheckBox Margin="14,0,0,0"
                                      FontSize="12"
                                      Content="鼠标同步"
                                      IsChecked="{Binding SyncMouse, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="操作指南"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="① 拖十字或移动鼠标后“添加窗口”加入列表" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="② 选中实际输入窗口 → “设为主窗口”" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="③ 用“测试同步”确认目标可接收消息" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="④ 开启同步后即可在主窗口正常输入" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   Text="快捷键：XButton1 开关同步 · XButton2 加光标窗口" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="14,0,14,10"
                Padding="10,5"
                CornerRadius="8"
                Background="#EEF2F7"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1">
            <TextBlock FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="提示：程序按管理员权限运行，使用 Windows 消息与低级钩子实现键鼠同步。" />
        </Border>
    </Grid>
</ui:FluentWindow>
