<ui:FluentWindow x:Class="Multiboxing.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:views="clr-namespace:Multiboxing.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="多窗口键鼠同步器"
                 Width="410"
                 Height="680"
                 MinWidth="380"
                 MinHeight="580"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Acrylic"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
                 Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="#4D0F172A" />
            <Ellipse Width="240" Height="240" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-90,-80,0,0" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5938BDF8" Offset="0" />
                        <GradientStop Color="#0038BDF8" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="48" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,-100,0" Opacity="0.45">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#598187FC" Offset="0" />
                        <GradientStop Color="#008187FC" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="48" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-130" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4DF472B6" Offset="0" />
                        <GradientStop Color="#00F472B6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="52" /></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <Grid Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TitleBar Grid.Row="0" Title="多窗口键鼠同步器" ShowMaximize="False" CanMaximize="False" FontSize="11" />
            <TabControl Grid.Row="1" Style="{StaticResource GlassTabControlStyle}">
                <TabItem Header="键鼠同步">
                    <views:SyncPage x:Name="SyncPageControl" />
                </TabItem>
                <TabItem Header="窗口预览">
                    <views:PreviewPage x:Name="PreviewPageControl" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</ui:FluentWindow>
