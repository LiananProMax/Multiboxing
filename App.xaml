<Application x:Class="KeyMouseSyncReplica.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Glass.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Legacy keys kept for compatibility, now mapped to the dark glass palette -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1226" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#40FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
