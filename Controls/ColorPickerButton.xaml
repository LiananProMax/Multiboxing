<UserControl x:Class="Multiboxing.Controls.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="104">
    <Grid>
        <Button x:Name="SwatchButton" Click="SwatchButton_Click" HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Swatch" Width="14" Height="14" CornerRadius="4"
                        BorderBrush="#66FFFFFF" BorderThickness="1" VerticalAlignment="Center" />
                <TextBlock x:Name="HexLabel" Grid.Column="1" Margin="6,0,0,0" FontSize="10"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource GlassCardStyle}" Width="216" Margin="4">
                <StackPanel>
                    <TextBlock Text="选择颜色" Style="{StaticResource SectionTitleStyle}" />
                    <UniformGrid x:Name="PresetGrid" Columns="6" Margin="0,8,0,0" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" Text="十六进制（如 #7DD3FC）" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HexBox" Style="{StaticResource GlassTextBoxStyle}" />
                        <Button Grid.Column="1" Margin="6,0,0,0" Content="应用" Click="ApplyHex_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
