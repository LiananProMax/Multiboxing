<UserControl x:Class="Multiboxing.Views.PreviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Multiboxing.Controls">
    <UserControl.Resources>
        <Style x:Key="PreviewStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="#94A3B8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviewRunning}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 状态卡 -->
        <Border Grid.Row="0" Margin="0,2,0,6" Style="{StaticResource GlassCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="EVE 客户端实时预览" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}">
                        <Run Text="已发现客户端 " /><Run Text="{Binding ClientCount, Mode=OneWay}" /><Run Text=" 个 · 默认预览 exefile 进程" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource PreviewStatusDotStyle}" />
                            <TextBlock Margin="5,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding PreviewStatusText}" />
                        </StackPanel>
                    </Border>
                    <Button Margin="0,6,0,0" HorizontalAlignment="Right" Content="{Binding TogglePreviewText}" Command="{Binding TogglePreviewCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 二级标签 -->
        <TabControl Grid.Row="1" Style="{StaticResource GlassSubTabControlStyle}">
            <!-- 常规 -->
            <TabItem Header="常规">
                <Border Style="{StaticResource GlassCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <CheckBox Content="最小化到系统托盘" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" ToolTip="开启后最小化主窗口时隐藏到托盘，双击托盘图标恢复" />
                            <CheckBox Margin="0,7,0,0" Content="跟踪客户端位置" IsChecked="{Binding EnableClientLayoutTracking, Mode=TwoWay}" ToolTip="记录并恢复 EVE 客户端窗口的位置" />
                            <CheckBox Margin="0,7,0,0" Content="隐藏当前客户端的预览" IsChecked="{Binding HideActiveClientThumbnail, Mode=TwoWay}" ToolTip="不显示当前正在操作的 EVE 客户端对应的缩略图" />
                            <CheckBox Margin="0,7,0,0" Content="最小化非活动客户端" IsChecked="{Binding MinimizeInactiveClients, Mode=TwoWay}" ToolTip="自动最小化非活动 EVE 客户端以节省 CPU/GPU" />
                            <CheckBox Margin="0,7,0,0" Content="隐藏客户端标题栏" IsChecked="{Binding HideCaptionOnClients, Mode=TwoWay}" />
                            <CheckBox Margin="0,7,0,0" Content="预览始终置顶" IsChecked="{Binding ShowThumbnailsAlwaysOnTop, Mode=TwoWay}" />
                            <CheckBox Margin="0,7,0,0" Content="EVE 未激活时隐藏预览" IsChecked="{Binding HideThumbnailsOnLostFocus, Mode=TwoWay}" ToolTip="仅当某个 EVE 客户端处于活动状态时显示缩略图" />
                            <CheckBox Margin="0,7,0,0" Content="每个客户端使用独立布局" IsChecked="{Binding EnablePerClientThumbnailLayouts, Mode=TwoWay}" ToolTip="根据当前活动客户端切换不同的缩略图位置布局" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="窗口动画样式" Style="{StaticResource SettingLabelStyle}" ToolTip="无动画在窗口模式下切换更干净；原始动画在固定窗口模式下更平滑" />
                                <ComboBox x:Name="AnimationStyleCombo" Grid.Column="1" Width="150" SelectedItem="{Binding WindowsAnimationStyle, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- 缩略 -->
            <TabItem Header="缩略">
                <Border Style="{StaticResource GlassCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="不透明度" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Grid.Column="1" FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                    <Run Text="{Binding ThumbnailOpacity, StringFormat={}{0:P0}, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                            <Slider Margin="0,4,0,0" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding ThumbnailOpacity, Mode=TwoWay}" />
                            <CheckBox Margin="0,9,0,0" Content="按倍数缩放" IsChecked="{Binding UseThumbnailScale, Mode=TwoWay}" ToolTip="倍数 = 缩略图 / 游戏窗口实际尺寸；&#x0a;比例不同的窗口各自等比缩放；&#x0a;右键+左键拖动缩略图会同步更新倍数" />
                            <Grid Margin="0,8,0,0" IsEnabled="{Binding UseThumbnailScale}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="缩放倍数" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Grid.Column="1" FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                    <Run Text="{Binding ThumbnailScale, StringFormat={}{0:0.00}×, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                            <Slider Margin="0,4,0,0" Minimum="0.1" Maximum="1" SmallChange="0.01" LargeChange="0.05" IsEnabled="{Binding UseThumbnailScale}" Value="{Binding ThumbnailScale, Mode=TwoWay}" />
                            <Grid Margin="0,8,0,0" IsEnabled="{Binding IsFixedSizeMode}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="缩略图尺寸" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Grid.Column="1" Margin="0,0,4,0" Style="{StaticResource MutedTextStyle}" Text="宽" VerticalAlignment="Center" />
                                <TextBox Grid.Column="2" Style="{StaticResource GlassNumericTextBoxStyle}" Text="{Binding ThumbnailWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="3" Margin="8,0,4,0" Style="{StaticResource MutedTextStyle}" Text="高" VerticalAlignment="Center" />
                                <TextBox Grid.Column="4" Style="{StaticResource GlassNumericTextBoxStyle}" Text="{Binding ThumbnailHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <CheckBox Margin="0,9,0,0" Content="按原始窗口比例显示缩略图" IsEnabled="{Binding IsFixedSizeMode}" IsChecked="{Binding KeepThumbnailAspectRatio, Mode=TwoWay}" ToolTip="开启后，&#x0a;缩略图尺寸作为最大范围，&#x0a;按游戏窗口宽高比等比缩放" />
                            <CheckBox Margin="0,9,0,0" Content="锁定缩略图位置" IsChecked="{Binding LockThumbnailLocation, Mode=TwoWay}" />
                            <CheckBox Margin="0,7,0,0" Content="缩略图吸附网格" IsChecked="{Binding ThumbnailSnapToGrid, Mode=TwoWay}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="网格大小" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Grid.Column="1" Margin="0,0,4,0" Style="{StaticResource MutedTextStyle}" Text="X" VerticalAlignment="Center" />
                                <TextBox Grid.Column="2" Style="{StaticResource GlassNumericTextBoxStyle}" Width="52" Text="{Binding ThumbnailSnapToGridSizeX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="3" Margin="8,0,4,0" Style="{StaticResource MutedTextStyle}" Text="Y" VerticalAlignment="Center" />
                                <TextBox Grid.Column="4" Style="{StaticResource GlassNumericTextBoxStyle}" Width="52" Text="{Binding ThumbnailSnapToGridSizeY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <CheckBox Margin="0,9,0,0" Content="不显示实时预览" IsChecked="{Binding PreventPreviews, Mode=TwoWay}" ToolTip="缩略图改为纯色占位，可在 JSON 中按客户端单独覆盖" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="占位背景色" Style="{StaticResource SettingLabelStyle}" />
                                <controls:ColorPickerButton Grid.Column="1" SelectedColor="{Binding PreventPreviewColorWpf, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- 缩放 -->
            <TabItem Header="缩放">
                <Border Style="{StaticResource GlassCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <CheckBox Content="悬停时放大缩略图" IsChecked="{Binding EnableThumbnailZoom, Mode=TwoWay}" />
                            <Grid Margin="0,9,0,0" IsEnabled="{Binding IsZoomSettingsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="放大倍数（2-10）" Style="{StaticResource SettingLabelStyle}" />
                                <TextBox Grid.Column="1" Style="{StaticResource GlassNumericTextBoxStyle}" Text="{Binding ThumbnailZoomFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Margin="0,10,0,4" Text="放大锚点" Style="{StaticResource SectionTitleStyle}" />
                            <controls:AnchorPicker SelectedAnchor="{Binding ThumbnailZoomAnchor, Mode=TwoWay}" IsEnabled="{Binding IsZoomSettingsEnabled}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}" Text="点击九宫格选择放大时固定的位置。" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- 叠加 -->
            <TabItem Header="叠加">
                <Border Style="{StaticResource GlassCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <CheckBox Content="显示角色名标签" IsChecked="{Binding ShowThumbnailOverlays, Mode=TwoWay}" />
                            <CheckBox Margin="0,7,0,0" Content="显示缩略图边框/标题" IsChecked="{Binding ShowThumbnailFrames, Mode=TwoWay}" />
                            <CheckBox Margin="0,7,0,0" Content="高亮当前客户端" IsChecked="{Binding EnableActiveClientHighlight, Mode=TwoWay}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="高亮颜色" Style="{StaticResource SettingLabelStyle}" />
                                <controls:ColorPickerButton Grid.Column="1" SelectedColor="{Binding ActiveClientHighlightColorWpf, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标签文字颜色" Style="{StaticResource SettingLabelStyle}" />
                                <controls:ColorPickerButton Grid.Column="1" SelectedColor="{Binding OverlayLabelColorWpf, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标签字体" Style="{StaticResource SettingLabelStyle}" />
                                <ComboBox x:Name="FontFamilyCombo" Grid.Column="1" Width="170" SelectedValue="{Binding OverlayFontFamily, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标签字号" Style="{StaticResource SettingLabelStyle}" />
                                <TextBox Grid.Column="1" Style="{StaticResource GlassNumericTextBoxStyle}" Width="52" Text="{Binding OverlayFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Grid.Column="2" Margin="10,0,0,0" Content="粗体" IsChecked="{Binding OverlayFontBold, Mode=TwoWay}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="3" Margin="10,0,0,0" Content="斜体" IsChecked="{Binding OverlayFontItalic, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="标签位置" Style="{StaticResource SectionTitleStyle}" />
                                    <controls:AnchorPicker Margin="0,4,0,0" HorizontalAlignment="Left" SelectedAnchor="{Binding OverlayLabelAnchor, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="循环组标记位置" Style="{StaticResource SectionTitleStyle}" />
                                    <controls:AnchorPicker Margin="0,4,0,0" HorizontalAlignment="Left" SelectedAnchor="{Binding CycleGroupIndicatorAnchor, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- 客户端 -->
            <TabItem Header="客户端">
                <Border Style="{StaticResource GlassCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="活动客户端（勾选 = 隐藏该缩略图）" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <ListBox ItemsSource="{Binding Clients}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsDisabled, Mode=TwoWay}" Foreground="{StaticResource TextBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="暂无 EVE 客户端">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClientCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource GlassCardStyle}">
            <Expander Header="关于窗口预览">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource BodyTextStyle}">
                        <Run Text="EVE-O-Preview " /><Run Text="{Binding VersionText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="仅显示未修改的 EVE 客户端实时画面，点击缩略图切换客户端，不会转发任何键鼠输入。配置文件为程序目录下的 EVE-O-Preview.json，预览进程与循环热键组在其中配置。" TextWrapping="Wrap" />
                    <Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="打开官方论坛说明" Command="{Binding OpenDocumentationCommand}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" Text="致谢原作者及历任维护者 Phrynohyas Tig-Rah 等贡献者。" />
                </StackPanel>
            </Expander>
        </Border>
    </Grid>
</UserControl>
