<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Liquid Glass palette (dark) ===== -->
    <Color x:Key="GlassTextColor">#F1F5F9</Color>
    <Color x:Key="GlassMutedColor">#A9B6CC</Color>
    <Color x:Key="GlassAccentColor">#7DD3FC</Color>
    <Color x:Key="GlassSuccessColor">#4ADE80</Color>
    <Color x:Key="GlassWarningColor">#FBBF24</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource GlassTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource GlassMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource GlassAccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource GlassSuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource GlassWarningColor}" />

    <!-- Card fill: brighter at the top, like light catching a glass edge -->
    <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="0.45" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Rim: bright top-left, fading around, faint return at bottom-right -->
    <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#80FFFFFF" Offset="0" />
        <GradientStop Color="#33FFFFFF" Offset="0.35" />
        <GradientStop Color="#14FFFFFF" Offset="0.7" />
        <GradientStop Color="#40FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3DFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Opaque fallback used when Acrylic / transparency is unavailable -->
    <LinearGradientBrush x:Key="FallbackBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1226" Offset="0" />
        <GradientStop Color="#131A33" Offset="0.5" />
        <GradientStop Color="#1B1440" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F7CFF" Offset="0" />
        <GradientStop Color="#7C5CFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryFillHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6B8FFF" Offset="0" />
        <GradientStop Color="#8F74FF" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Text ===== -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Glass card ===== -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassRimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Small status / state pill -->
    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="BorderBrush" Value="#40FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ===== Buttons ===== -->
    <ControlTemplate x:Key="GlassButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="10"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.38" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="GlassButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33FFFFFF" Offset="0" />
                    <GradientStop Color="#14FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource GlassRimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="GlassPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
        <Setter Property="Background" Value="{StaticResource PrimaryFillBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="30" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryFillHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Default button in this app is a glass button -->
    <Style TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}" />

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ===== Window list ===== -->
    <Style x:Key="GlassListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="#14FFFFFF"
                            BorderBrush="#26FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2E7DD3FC" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#8C7DD3FC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ===== Tabs (pill) ===== -->
    <Style x:Key="GlassTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root" CornerRadius="999" Padding="{TemplateBinding Padding}"
                            Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryFillBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#8C7DD3FC" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource GlassTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,6" IsItemsHost="True" />
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次级标签更小 -->
    <Style x:Key="GlassSubTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource GlassTabItemStyle}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style x:Key="GlassSubTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource GlassTabControlStyle}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource GlassSubTabItemStyle}" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style x:Key="GlassTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassNumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource GlassTextBoxStyle}">
        <Setter Property="Width" Value="64" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!-- ComboBox 隐式样式放在 App.xaml 中，需基于 WPF-UI 的 DefaultComboBoxStyle，
         不能在此处用无模板的隐式样式整体替换，否则会退回系统浅色模板导致白底白字。 -->

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 设置行标签 -->
    <Style x:Key="SettingLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
